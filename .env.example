# Copy this file to .env and replace the placeholder with your NewsAPI key.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tech_news

NEWS_API_KEY=YOUR_NEW_API_KEY
NEWS_API_URL=https://newsapi.org/v2/everything
NEWS_API_QUERY=technology OR AI OR cybersecurity OR quantum OR cloud computing OR software OR startup
NEWS_REQUEST_TIMEOUT_SECONDS=15

NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
